{
  "name": "pdf-image-extractor-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "node server/index.ts",
    "build:frontend": "node scripts/build-frontend.js",
    "test": "node --test",
